{
	// 型検査専用（bun run chk:types）。ビルドは esbuild が行い型を見ないので、
	// リリース経路（vscode:prepublish）ではこれが唯一の型検査になる。
	// views/ を含めないのは、vite の型と bun-types の ImportMeta 宣言が衝突して
	// node_modules 内のエラーが出るため（自前のコードには影響しない）
	"extends": "./tsconfig.json",
	"include": ["src/**/*", "server/src/**/*", "test/**/*", "build.ts", "release_chk.ts"]
}
